{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Rojo Server",
      "type": "shell",
      "command": "rojo serve place.project.json",
      "presentation": {
        "group": "rojo",
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Start Sourcemap Watch",
      "type": "shell",
      "command": "rojo sourcemap --include-non-scripts --watch -o sourcemap.json place.project.json",
      "presentation": {
        "group": "rojo",
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Start Rojo Server & Sourcemap",
      "type": "shell",
      "problemMatcher": [],
      "dependsOn": ["Start Rojo Server", "Start Sourcemap Watch"]
    },
    {
      "label": "Run Jest Tests",
      "type": "shell",
      "command": "lune run tests",
      "presentation": {
        "group": "test",
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run TestEZ Tests",
      "type": "shell",
      "command": "lune run tests testez",
      "presentation": {
        "group": "test",
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
